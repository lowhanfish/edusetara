# ==========================
# APPLICATION
# ==========================
APP_NAME=EduSetara
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ==========================
# SHARED MYSQL SERVER
# ==========================
DB_HOST=127.0.0.1
DB_PORT=3306

# ==========================
# PRIMARY DATABASE
# ==========================
DB_NAME=edusetara
DB_USER=edusetara_user
DB_PASSWORD=replace_me

# ==========================
# EXTERNAL DATABASE: SIMPEG
# ==========================
SIMPEG_DB_NAME=simpeg
SIMPEG_DB_USER=simpeg_reader
SIMPEG_DB_PASSWORD=

# ==========================
# EXTERNAL DATABASE: EGOV
# ==========================
EGOV_DB_NAME=egov
EGOV_DB_USER=egov_reader
EGOV_DB_PASSWORD=

# ==========================
# DATABASE POOL — PRIMARY
# ==========================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ==========================
# DATABASE POOL — EXTERNAL
# ==========================
EXTERNAL_DB_POOL_SIZE=5
EXTERNAL_DB_MAX_OVERFLOW=5
EXTERNAL_DB_POOL_TIMEOUT=30
EXTERNAL_DB_POOL_RECYCLE=1800

# ==========================
# AUTHENTICATION
# ==========================
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=edusetara-api
JWT_AUDIENCE=edusetara-client

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================
# COOKIE SECURITY
# ==========================
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_ACCESS_PATH=/
COOKIE_REFRESH_PATH=/api/v1/auth

# ==========================
# CORS
# ==========================
ALLOWED_ORIGINS=["http://localhost:3000"]
